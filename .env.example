API_FOOTBALL_KEY=your_api_football_key_here
NUXT_SESSION_PASSWORD=your_nuxt_session_password_here

# =====================
# Base de données de l'application Nuxt
# =====================
APP_DB_USER=football
APP_DB_PASSWORD=football_password
APP_DB_NAME=football_db

# =====================
# GlitchTip configuration
# =====================
GLITCHTIP_DB_PASSWORD=glitchtip_password
# ATTENTION : ce DATABASE_URL est réservé à GlitchTip. Le service `web` (Nuxt)
# le redéfinit dans docker-compose.yml pour pointer vers `app-db`, sinon l'app
# écrirait dans la base de GlitchTip (→ erreur 500 à l'inscription).
DATABASE_URL=postgres://glitchtip:glitchtip_password@glitchtip-db:5432/glitchtip_db
REDIS_URL=redis://glitchtip-redis:6379/0
SECRET_KEY=your_long_random_secret_key_here
PORT=8000
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_ENABLE_USER_REGISTRATION=True
GLITCHTIP_ENABLE_ORGANIZATION_CREATION=True
# EMAIL_URL=smtp://user:password@smtp.example.com:587

# =====================
# Umami configuration
# =====================
UMAMI_DB_PASSWORD=umami_password
UMAMI_APP_SECRET=change_me_in_production_umami_secret

# Website ID généré depuis le dashboard Umami (http://localhost:3001)
# Créer un site dans Umami, copier l'ID et le coller ici
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_HOST=http://localhost:3001

# =====================
# GlitchTip SDK (frontend)
# =====================
NUXT_PUBLIC_GLITCHTIP_DSN=http://<key>@localhost:8000/<project_id>
